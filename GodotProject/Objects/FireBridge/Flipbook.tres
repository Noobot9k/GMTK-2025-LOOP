[resource]
code = "shader_type spatial;
render_mode blend_mix, depth_draw_opaque, depth_test_default, cull_disabled, diffuse_lambert, specular_schlick_ggx;

uniform float FPS = 8.0;
uniform vec2 Tiles = vec2(2.000000, 2.000000);
uniform sampler2D albedo : source_color;
uniform sampler2D emission : source_color, hint_default_black;
uniform float emissionMultiplier = 1.0;



void fragment() {
// Input:17
	vec4 n_out17p0 = COLOR;


// Input:5
	vec2 n_out5p0 = UV;


// FloatParameter:16
	float n_out16p0 = FPS;


	float n_out15p0;
// ScaledTIME:15
	{
		n_out15p0 = n_out16p0 * TIME;
	}


// FloatOp:26
	float n_in26p0 = 0.00000;
	float n_out26p0 = n_in26p0 + n_out15p0;


// FloatFunc:14
	float n_out14p0 = floor(n_out26p0);


// Vector2Parameter:4
	vec2 n_out4p0 = Tiles;
	float n_out4p1 = n_out4p0.r;
	float n_out4p2 = n_out4p0.g;


// FloatOp:9
	float n_out9p0 = mod(n_out14p0, n_out4p1);


// FloatOp:10
	float n_out10p0 = n_out14p0 / n_out4p2;


// FloatFunc:11
	float n_out11p0 = floor(n_out10p0);


// VectorCompose:12
	vec2 n_out12p0 = vec2(n_out9p0, n_out11p0);


// VectorOp:7
	vec2 n_out7p0 = n_out5p0 + n_out12p0;


// VectorOp:6
	vec2 n_out6p0 = n_out7p0 / n_out4p0;


	vec4 n_out3p0;
// Texture2D:3
	n_out3p0 = texture(albedo, n_out6p0);


// VectorOp:18
	vec4 n_out18p0 = n_out17p0 * n_out3p0;
	float n_out18p4 = n_out18p0.a;


	vec4 n_out21p0;
// Texture2D:21
	n_out21p0 = texture(emission, n_out6p0);


// FloatParameter:22
	float n_out22p0 = emissionMultiplier;


// VectorOp:23
	vec4 n_out23p0 = n_out21p0 * vec4(n_out22p0);


// Output:0
	ALBEDO = vec3(n_out18p0.xyz);
	ALPHA = n_out18p4;
	EMISSION = vec3(n_out23p0.xyz);


}
"
